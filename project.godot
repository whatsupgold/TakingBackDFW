; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Taking back DFW"
config/description="M1 prototype: push the Red Army out of Arlington, in a compressed Dallas–Fort Worth."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="soldiers"
3d_physics/layer_3="red army"
3d_physics/layer_4="vehicles"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0

[shader_globals]

unit_outline={
"type": "float",
"value": 0.1
}
soldier_outline={
"type": "float",
"value": 0.05
}
